        <span>Instagram</span>
      </a>

      <!-- TikTok -->
      <a 
        href="#materialy" 
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 hover:text-white text-xs font-semibold transition-all"
        title="TikTok"
      >
