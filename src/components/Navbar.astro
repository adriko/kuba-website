---
---
<!-- Główna belka nawigacji (Bez zbędnej górnej belki, pełna czytelność na PC i Mobile) -->
<header class="sticky top-0 z-50 bg-[#08070b]/90 backdrop-blur-xl border-b border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    
    <!-- Logo JK -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-indigo-600 rounded-xl blur opacity-40 group-hover:opacity-75 transition duration-300"></div>
        <span class="relative w-10 h-10 rounded-xl bg-zinc-900 border border-white/15 text-white font-extrabold flex items-center justify-center text-base shadow-md">
          JK
        </span>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="font-extrabold text-white text-base tracking-tight">Jakub Korzeń</span>
        <span class="text-xs text-zinc-300 font-medium">Lekcje u Kuby</span>
      </div>
    </a>

    <!-- Menu nawigacji (Desktop - wyraźniejsza czcionka i jaśniejszy kolor) -->
    <nav aria-label="Główna nawigacja" class="hidden md:flex items-center gap-8 text-base font-semibold text-zinc-200">
      <a href="#o-mnie" class="hover:text-violet-400 transition-colors">O mnie</a>
      <a href="#oferta" class="hover:text-violet-400 transition-colors">Oferta</a>
      <a href="#arkusze" class="hover:text-violet-400 transition-colors">Arkusze PDF</a>
      <a href="#opinie" class="hover:text-violet-400 transition-colors">Opinie (5.0★)</a>
      <a href="#faq" class="hover:text-violet-400 transition-colors">FAQ</a>
      <a href="#kontakt" class="hover:text-violet-400 transition-colors">Kontakt</a>
    </nav>

    <!-- Przycisk Zapisz się (Desktop) i Przycisk Hamburger (Mobile) -->
    <div class="flex items-center gap-3">
      <a 
        href="#kontakt" 
        class="hidden sm:inline-flex px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 rounded-xl transition-all shadow-lg shadow-violet-600/30"
      >
        Zapisz się
      </a>

      <!-- Przycisk Menu Mobilnego (Hamburger) -->
      <button 
        id="menu-btn" 
        type="button" 
        aria-label="Otwórz menu" 
        class="md:hidden w-10 h-10 rounded-xl bg-white/[0.06] border border-white/10 text-white flex items-center justify-center focus:outline-none"
      >
        <svg id="menu-icon" width="20" height="20" class="fill-current" viewBox="0 0 24 24">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Wysuwane menu mobilne z boku/góry (Mobile Drawer) -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-[#08070b]/95 backdrop-blur-2xl transform translate-x-full transition-transform duration-300 md:hidden flex flex-col justify-center px-8 space-y-6 text-xl font-bold text-zinc-200">
  <a href="#o-mnie" class="mobile-link hover:text-violet-400 transition-colors border-b border-white/[0.06] pb-4">O mnie</a>
  <a href="#oferta" class="mobile-link hover:text-violet-400 transition-colors border-b border-white/[0.06] pb-4">Oferta</a>
  <a href="#arkusze" class="mobile-link hover:text-violet-400 transition-colors border-b border-white/[0.06] pb-4">Arkusze PDF</a>
  <a href="#opinie" class="mobile-link hover:text-violet-400 transition-colors border-b border-white/[0.06] pb-4">Opinie (5.0★)</a>
  <a href="#faq" class="mobile-link hover:text-violet-400 transition-colors border-b border-white/[0.06] pb-4">FAQ</a>
  <a href="#kontakt" class="mobile-link text-violet-400 pb-4">Kontakt & Zapisy →</a>
</div>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    if (mobileMenu) {
      mobileMenu.classList.toggle('translate-x-full');
      document.body.classList.toggle('overflow-hidden');
    }
  }

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', toggleMenu);
    mobileLinks.forEach(link => {
      link.addEventListener('click', toggleMenu);
    });
  }
</script>