---
---
<header class="sticky top-0 z-40 bg-[#0d0e12]/95 backdrop-blur-md border-b border-white/10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- Logo i nazwisko -->
    <a href="#" class="flex items-center gap-3 group">
      <span class="w-9 h-9 rounded-xl bg-zinc-800 border border-white/15 text-white font-bold flex items-center justify-center text-xs tracking-tight group-hover:border-white/30 transition-colors shadow-sm">
        JK
      </span>
      <div class="flex items-baseline gap-1.5">
        <span class="font-bold text-[15px] text-white tracking-tight leading-none">Jakub Korzeń</span>
        <span class="text-xs text-zinc-400 font-normal leading-none hidden sm:inline">/ Lekcje u Kuby</span>
      </div>
    </a>

    <!-- Menu Desktop (większa, wyraźna czcionka i lepszy kontrast) -->
    <nav aria-label="Główna nawigacja" class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-300">
      <a href="#o-zajeciach" class="hover:text-white transition-colors">O zajęciach</a>
      <a href="#zakres" class="hover:text-white transition-colors">Zakres</a>
      <a href="#opinie" class="hover:text-white transition-colors">Opinie</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
    </nav>

    <!-- Przycisk Desktop & Hamburger Mobile -->
    <div class="flex items-center gap-3">
      <a 
        href="#kontakt" 
        class="hidden md:inline-flex px-4 py-2 text-xs font-bold text-zinc-950 bg-white hover:bg-zinc-100 rounded-lg transition-all shadow-sm"
      >
        Kontakt i zapisy
      </a>

      <!-- Przycisk otwierający wysuwane menu -->
      <button 
        id="menu-open-btn" 
        type="button" 
        aria-label="Otwórz menu nawigacji" 
        class="md:hidden p-2 rounded-lg bg-zinc-900 border border-white/10 text-zinc-200 hover:text-white hover:bg-zinc-800 transition-colors"
      >
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Tło przyciemniające (Backdrop) dla menu mobilnego -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- Wysuwany z boku panel mobilny (Off-canvas Drawer) -->
<aside 
  id="drawer-panel" 
  class="fixed top-0 right-0 bottom-0 w-[280px] bg-[#111216] border-l border-white/10 p-6 z-50 flex flex-col justify-between translate-x-full transition-transform duration-300 ease-in-out md:hidden shadow-2xl"
>
  <div>
    <!-- Górny nagłówek szuflady z przyciskiem zamknięcia -->
    <div class="flex items-center justify-between pb-4 border-b border-white/10">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-zinc-800 border border-white/15 text-white font-bold flex items-center justify-center text-xs">
          JK
        </span>
        <span class="text-sm font-bold text-white">Nawigacja</span>
      </div>
      <button 
        id="menu-close-btn" 
        type="button" 
        aria-label="Zamknij menu" 
        class="p-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors"
      >
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Linki nawigacyjne w menu bocznym -->
    <nav class="flex flex-col gap-4 mt-6 text-base font-semibold text-zinc-300">
      <a href="#o-zajeciach" class="drawer-link hover:text-white transition-colors py-1">O zajęciach</a>
      <a href="#zakres" class="drawer-link hover:text-white transition-colors py-1">Zakres materiału</a>
      <a href="#opinie" class="drawer-link hover:text-white transition-colors py-1">Opinie uczniów</a>
      <a href="#faq" class="drawer-link hover:text-white transition-colors py-1">Częste pytania (FAQ)</a>
    </nav>
  </div>

  <!-- Dolna część szuflady -->
  <div class="space-y-3 pt-6 border-t border-white/10">
    <a 
      href="#kontakt" 
      class="drawer-link block w-full py-2.5 px-4 text-center text-xs font-bold text-zinc-950 bg-white hover:bg-zinc-100 rounded-lg transition-all"
    >
      Kontakt i zapisy
    </a>
    <a 
      href="https://www.youtube.com/@lekcjeukuby" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="block text-center text-xs text-zinc-400 hover:text-zinc-200 py-1 transition-colors"
    >
      YouTube: @lekcjeukuby ↗
    </a>
  </div>
</aside>

<script>
  const openBtn = document.getElementById('menu-open-btn');
  const closeBtn = document.getElementById('menu-close-btn');
  const backdrop = document.getElementById('drawer-backdrop');
  const panel = document.getElementById('drawer-panel');
  const drawerLinks = document.querySelectorAll('.drawer-link');

  function openDrawer() {
    if (backdrop && panel) {
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      panel.classList.remove('translate-x-full');
      document.body.classList.add('overflow-hidden');
    }
  }

  function closeDrawer() {
    if (backdrop && panel) {
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
      document.body.classList.remove('overflow-hidden');
    }
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  drawerLinks.forEach(link => link.addEventListener('click', closeDrawer));
</script>