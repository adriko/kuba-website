---
<!-- Górna subtelna belka z informacją -->
<div class="bg-[#08070b]/90 border-b border-white/[0.06] text-zinc-400 text-xs py-2 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto flex items-center justify-between gap-3">
    
    <div class="flex items-center gap-2 truncate">
      <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse shrink-0"></span>
      <span class="truncate">
        Darmowe patenty maturalne na 
        <a href="https://www.youtube.com/@lekcjeukuby" target="_blank" rel="noopener noreferrer" class="text-zinc-200 font-semibold underline underline-offset-2 hover:text-violet-300 transition-colors">
          YouTube @lekcjeukuby
        </a>
      </span>
    </div>

    <!-- Ikony ze stałym rozmiarem width/height oraz etykietami dostępności aria-label -->
    <div class="flex items-center gap-3.5 shrink-0 text-zinc-400">
      <a href="https://www.youtube.com/@lekcjeukuby" target="_blank" rel="noopener noreferrer" aria-label="Kanał YouTube Lekcje u Kuby" class="hover:text-white transition-colors" title="YouTube">
        <svg width="15" height="15" class="w-3.5 h-3.5 fill-current block" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      <a href="https://maps.app.goo.gl/bdKPyWNdRER2nRZ26" target="_blank" rel="noopener noreferrer" aria-label="Opinie w Google Maps" class="hover:text-amber-400 transition-colors" title="Google Maps 5.0 ★">
        <svg width="15" height="15" class="w-3.5 h-3.5 fill-current block" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      </a>
      <a href="#spolecznosc" aria-label="Serwer Discord" class="hover:text-white transition-colors" title="Discord">
        <svg width="15" height="15" class="w-3.5 h-3.5 fill-current block" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
      </a>
    </div>

  </div>
</div>

<!-- Główna belka nawigacji -->
<header class="sticky top-0 z-50 bg-[#08070b]/80 backdrop-blur-xl border-b border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <a href="#" class="flex items-center gap-3 group">
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-indigo-600 rounded-xl blur opacity-30 group-hover:opacity-60 transition duration-300"></div>
        <span class="relative w-9 h-9 rounded-xl bg-zinc-900 border border-white/10 text-white font-extrabold flex items-center justify-center text-sm shadow-sm">
          JK
        </span>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="font-extrabold text-white text-base tracking-tight">Jakub Korzeń</span>
        <span class="text-[11px] text-zinc-400 font-medium">Lekcje u Kuby</span>
      </div>
    </a>

    <!-- Menu nawigacji (Desktop) -->
    <nav aria-label="Główna nawigacja" class="hidden md:flex items-center gap-7 text-sm font-medium text-zinc-400">
      <a href="#o-mnie" class="hover:text-white transition-colors">O mnie</a>
      <a href="#oferta" class="hover:text-white transition-colors">Oferta</a>
      <a href="#arkusze" class="hover:text-white transition-colors">Arkusze PDF</a>
      <a href="#opinie" class="hover:text-white transition-colors">Opinie (5.0★)</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
      <a href="#kontakt" class="hover:text-white transition-colors">Kontakt</a>
    </nav>

    <a 
      href="#kontakt" 
      class="px-4 py-2 text-xs font-bold text-white bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 rounded-xl transition-all shadow-lg shadow-violet-600/25 hover:shadow-violet-600/40"
    >
      Zapisz się
    </a>
  </div>
</header>

<!-- Pływający pasek nawigacji mobilnej (Floating Bottom Pill Bar - widoczny tylko na smartfonach) -->
<nav aria-label="Nawigacja mobilna" class="md:hidden fixed bottom-4 inset-x-4 z-50 bg-zinc-950/90 backdrop-blur-xl border border-white/15 rounded-2xl px-2 py-2 shadow-2xl shadow-black/80 flex items-center justify-around text-[11px] font-semibold text-zinc-400">
  <a href="#oferta" class="px-2.5 py-1.5 rounded-xl hover:text-white hover:bg-white/[0.06] transition-all">Oferta</a>
  <a href="#arkusze" class="px-2.5 py-1.5 rounded-xl hover:text-white hover:bg-white/[0.06] transition-all">PDF</a>
  <a href="#opinie" class="px-2.5 py-1.5 rounded-xl hover:text-white hover:bg-white/[0.06] transition-all flex items-center gap-1">
    <span class="text-amber-400">★</span> Opinie
  </a>
  <a href="#faq" class="px-2.5 py-1.5 rounded-xl hover:text-white hover:bg-white/[0.06] transition-all">FAQ</a>
  <a href="#kontakt" class="px-3 py-1.5 rounded-xl bg-violet-600 text-white font-bold shadow-sm">Zapisy</a>
</nav>