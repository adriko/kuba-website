---
---
<!-- Główna belka nawigacji -->
<header class="sticky top-0 z-50 bg-[#08070b]/80 backdrop-blur-xl border-b border-white/[0.08]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    
    <!-- Logo JK z fioletowym akcentem Darkrise -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-indigo-600 rounded-xl blur opacity-30 group-hover:opacity-60 transition duration-300"></div>
        <span class="relative w-9 h-9 rounded-xl bg-zinc-900 border border-white/10 text-white font-extrabold flex items-center justify-center text-sm shadow-sm">
          JK
        </span>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="font-extrabold text-white text-base tracking-tight">Jakub Korzeń</span>
        <span class="text-[11px] text-zinc-400 font-medium">Matematyka & Fizyka</span>
      </div>
    </a>

    <!-- Menu nawigacji -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400">
      <a href="#o-mnie" class="hover:text-white transition-colors">O mnie</a>
      <a href="#oferta" class="hover:text-white transition-colors">Oferta</a>
      <a href="#materialy" class="hover:text-white transition-colors">Społeczność</a>
      <a href="#kontakt" class="hover:text-white transition-colors">Kontakt</a>
    </nav>

    <!-- Przycisk Zapisz się z fioletowym podświetleniem -->
    <a 
      href="#kontakt" 
      class="px-4 py-2 text-xs font-bold text-white bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 rounded-xl transition-all shadow-lg shadow-violet-600/25 hover:shadow-violet-600/40"
    >
      Zapisz się
    </a>
  </div>
</header>