---
---

<section
  id="o-zajeciach"
  class="relative pt-2 pb-10 sm:pt-8 md:pt-14 md:pb-20 border-b border-white/[0.08] overflow-hidden"
>
  <!-- Tło siatki geometrycznej i subtelna poświata -->
  <div class="absolute inset-0 bg-math-grid [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none opacity-60"></div>
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-12 gap-4 sm:gap-6 md:gap-8 lg:gap-12 items-center">
      
      <!-- Lewa kolumna: Czyste, eleganckie zdjęcie bez zbędnych gadżetów i mikro-ramek -->
      <div class="md:col-span-5 flex flex-col items-center md:items-start">
        <div class="w-28 sm:w-48 md:w-full md:max-w-[260px] aspect-square rounded-2xl overflow-hidden border border-white/10 bg-zinc-900 shadow-xl">
          <img
            src="/kuba.png"
            alt="Jakub Korzeń – Nauczyciel i Korepetytor Matematyki oraz Fizyki"
            width="260"
            height="260"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover object-top"
          />
        </div>

        <!-- Dyskretny podpis pod zdjęciem: minimalistyczny, bez kropek i ocen -->
        <div class="mt-2 text-center md:text-left text-xs text-zinc-400">
          <span class="font-medium text-zinc-300">Munina k. Jarosławia</span>
          <span class="text-zinc-600 mx-1">•</span>
          <span>Online</span>
        </div>
      </div>

      <!-- Prawa kolumna -->
      <div class="md:col-span-7 space-y-3 sm:space-y-5 text-center md:text-left">
        <div class="space-y-2 sm:space-y-3">
          
          <!-- Czysty, nowoczesny badge bez migającej zielonej kropki -->
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs text-zinc-300 font-medium">
            <span>Trwają zapisy na zajęcia</span>
            <span class="text-zinc-600 mx-1.5 hidden sm:inline">•</span>
            <span class="text-zinc-400 hidden sm:inline">Wolne godziny popołudniowe</span>
          </div>

          <!-- Większy, mocny nagłówek na telefonach -->
          <h1 class="text-[26px] sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
            Pewność przy tablicy. <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-sky-300">
              Spokój i wysoki wynik na egzaminie.
            </span>
          </h1>

          <!-- Większa, komfortowa czcionka 15px (text-[15px]) -->
          <p class="text-[15px] sm:text-base text-zinc-300 leading-relaxed max-w-xl mx-auto md:mx-0">
            Cześć, jestem Kuba! Od ponad 5 lat pomagam uczniom zamienić chaos w zeszycie na logiczne myślenie i stabilne oceny. Jako inżynier pokazuję, jak działają wzory w praktyce, zamiast uczyć ich mechanicznie na pamięć. Razem przygotujemy solidną bazę pod maturę CKE lub egzamin ósmoklasisty.
          </p>
        </div>

        <!-- Pasek 3 statystyk – idealna linia zamknięcia pierwszego ekranu na smartfonie -->
        <div class="flex items-center justify-center md:justify-start gap-4 sm:gap-10 py-3 border-y border-white/[0.08]">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-white tracking-tight">5+ lat</div>
            <div class="text-xs text-zinc-400 font-medium">doświadczenia</div>
          </div>
          <div class="w-px h-8 bg-white/10"></div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-sky-400 tracking-tight">&gt;90%</div>
            <div class="text-xs text-zinc-400 font-medium">zdawalności matur</div>
          </div>
          <div class="w-px h-8 bg-white/10"></div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-zinc-200 tracking-tight">PDF</div>
            <div class="text-xs text-zinc-400 font-medium">notatki po lekcji</div>
          </div>
        </div>

        <!-- Przyciski akcji (pojawiają się od razu przy pierwszym muśnięciu palcem w dół) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center md:justify-start gap-2.5 pt-2">
          <a
            href="#kontakt"
            class="px-5 py-3 sm:py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-bold text-sm text-center transition-all shadow-md active:scale-95"
          >
            Sprawdź wolne terminy →
          </a>
          <a
            href="https://www.youtube.com/@lekcjeukuby"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 sm:py-2.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-zinc-200 hover:text-white font-medium text-sm transition-all flex items-center justify-center gap-2 active:scale-95"
          >
            <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>Darmowe lekcje na YouTube ↗</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>