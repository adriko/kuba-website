---
---
<section class="relative overflow-hidden bg-slate-900 text-white pt-10 pb-20 md:pt-16 md:pb-28">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(99,102,241,0.18),transparent_55%)] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Lewa kolumna: Treść -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-800/90 border border-slate-700 text-slate-200 text-xs font-semibold shadow-inner">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Przygotowanie do matury i egzaminów • Zapisy bezpośrednie</span>
        </div>

        <!-- Nagłówek -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
          Zrozum matematykę i fizykę. <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-indigo-400">
            Bez stresu, na Lekcjach u Kuby.
          </span>
        </h1>

        <p class="text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Cześć, jestem Jakub. Pomagam uczniom i maturzystom opanować materiał bez bezmyślnego wkuwania. Pokazuję, że każdy problem da się rozłożyć na proste kroki.
        </p>

        <!-- Pigułki: Forma zajęć (Online / Stacjonarnie) -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 pt-1">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-800/90 border border-slate-700 text-xs font-semibold text-slate-200 shadow-sm">
            <span class="text-indigo-400">💻</span> Zajęcia Online (cała Polska)
          </span>
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-800/90 border border-slate-700 text-xs font-semibold text-slate-200 shadow-sm">
            <span class="text-blue-400">📍</span> Zajęcia Stacjonarne
          </span>
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-800/90 border border-slate-700 text-xs font-semibold text-slate-200 shadow-sm">
            <span class="text-emerald-400">✍️</span> Cyfrowa tablica & notatki PDF
          </span>
        </div>

        <!-- Banerek YT -->
        <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700/80 flex items-center gap-3.5 text-left max-w-xl mx-auto lg:mx-0">
          <div class="w-10 h-10 rounded-xl bg-red-600/20 text-red-500 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <div class="text-xs">
            <span class="font-bold text-white block text-sm">Darmowe lekcje i triki dla uczniów</span>
            <span class="text-slate-300">Na kanale YouTube rozwiązuję zadania ze zbiorów i tłumaczę trudne pojęcia w przystępny sposób.</span>
          </div>
        </div>

        <!-- Przyciski akcji -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="#kontakt" 
            class="w-full sm:w-auto px-8 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/30 transition-all text-center"
          >
            Sprawdź wolne terminy
          </a>
          <a 
            href="https://www.youtube.com/@lekcjeukuby" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-3.5 bg-slate-800 hover:bg-slate-700 text-white font-bold border border-slate-700 rounded-xl transition-all text-center flex items-center justify-center gap-2.5 shadow-sm"
          >
            <svg class="w-5 h-5 text-red-500 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            Lekcje u Kuby na YT
          </a>
        </div>

        <!-- Liczby -->
        <div class="pt-6 border-t border-slate-800 grid grid-cols-2 gap-6 max-w-md mx-auto lg:mx-0">
          <div>
            <div class="text-3xl font-extrabold text-white">5+ lat</div>
            <div class="text-xs text-slate-400 mt-0.5">doświadczenia w nauczaniu i przygotowaniu do matur</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-indigo-400">>90%</div>
            <div class="text-xs text-slate-400 mt-0.5">zdawalność i zadowoleni uczniowie</div>
          </div>
        </div>

      </div>

      <!-- Prawa kolumna: Zdjęcie Kuby i kafelki -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-sm">
          
          <div class="absolute -inset-1.5 bg-gradient-to-r from-indigo-500 to-blue-500 rounded-3xl blur-lg opacity-30"></div>
          
          <div class="relative bg-slate-800 border border-slate-700/80 rounded-3xl p-5 shadow-2xl">
            
            <div class="relative rounded-2xl overflow-hidden aspect-4/5 bg-slate-900 border border-slate-700">
              <img 
                src="/kuba.png" 
                alt="Jakub Korzeń - Lekcje u Kuby" 
                class="w-full h-full object-cover object-top"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
              
              <div class="absolute bottom-4 left-4 right-4">
                <span class="text-xs font-bold uppercase tracking-wider text-indigo-300 block">Nauczyciel & Twórca</span>
                <span class="text-2xl font-extrabold text-white">Jakub Korzeń</span>
              </div>
            </div>

            <!-- Kafelki pod zdjęciem -->
            <div class="mt-4 space-y-2.5">
              <div class="grid grid-cols-2 gap-2.5 text-center">
                <div class="py-3 px-3 rounded-2xl bg-indigo-950/80 border border-indigo-500/50 shadow-sm">
                  <div class="text-indigo-300 font-extrabold text-sm sm:text-base flex items-center justify-center gap-1.5">
                    <span class="text-indigo-400">∑</span> Matematyka
                  </div>
                  <div class="text-xs text-slate-300 font-medium mt-0.5">Główny profil (80%)</div>
                </div>

                <div class="py-3 px-3 rounded-2xl bg-blue-950/80 border border-blue-500/50 shadow-sm">
                  <div class="text-blue-300 font-extrabold text-sm sm:text-base flex items-center justify-center gap-1.5">
                    <span class="text-blue-400">⚡</span> Fizyka
                  </div>
                  <div class="text-xs text-slate-300 font-medium mt-0.5">Wsparcie (20%)</div>
                </div>
              </div>

              <!-- Matura i forma -->
              <div class="py-2.5 px-4 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-center">
                <div class="text-emerald-300 font-bold text-xs sm:text-sm flex items-center justify-center gap-2">
                  <span>🎯</span> Matura & Egzaminy • Online i Stacjonarnie
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>