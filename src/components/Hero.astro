---
---
<section class="pt-8 pb-16 md:pt-12 md:pb-20 border-b border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Nagłówek Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-medium shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse"></span>
        <span>Przygotowanie do matury CKE • Zapisy bezpośrednie</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
        Zrozum matematykę i fizykę. <br />
        <span class="bg-gradient-to-r from-violet-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent">
          Bez stresu, na Lekcjach u Kuby.
        </span>
      </h1>

      <p class="text-base sm:text-lg text-zinc-400 max-w-xl mx-auto leading-relaxed">
        Cześć, jestem Jakub. Rozkładam skomplikowane zagadnienia i wzory na proste, logiczne kroki. Bez bezmyślnego wkuwania na pamięć.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="#kontakt" 
          class="w-full sm:w-auto px-7 py-3.5 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white font-bold text-sm rounded-xl transition-all shadow-lg shadow-violet-600/30 hover:scale-[1.02]"
        >
          Sprawdź wolne terminy
        </a>
        <a 
          href="https://www.youtube.com/@lekcjeukuby" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-7 py-3.5 bg-white/[0.04] hover:bg-white/[0.08] text-zinc-200 hover:text-white font-semibold text-sm border border-white/[0.08] rounded-xl transition-all flex items-center justify-center gap-2"
        >
          <svg width="16" height="16" class="w-4 h-4 text-red-500 fill-current block" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          Materiały na YouTube
        </a>
      </div>
    </div>

    <!-- Siatka BENTO GRID z klasami .bento-card -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
      
      <!-- Bento Karta 1: Karta ze zdjęciem Kuby -->
      <div class="bento-card md:col-span-5 bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-violet-500/40 transition-all rounded-3xl p-5 flex flex-col justify-between group">
        <div class="relative z-10 rounded-2xl overflow-hidden aspect-4/5 bg-zinc-950 border border-white/[0.06]">
          <img 
            src="/kuba.png" 
            alt="Jakub Korzeń - Lekcje u Kuby" 
            class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#08070b]/90 via-transparent to-transparent"></div>
          
          <div class="absolute bottom-4 left-4 right-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-violet-300 block">Nauczyciel & Twórca</span>
            <span class="text-2xl font-extrabold text-white">Jakub Korzeń</span>
          </div>
        </div>

        <div class="relative z-10 mt-4 p-3 rounded-xl bg-white/[0.02] border border-white/[0.06] flex items-center justify-between text-xs font-medium text-zinc-300">
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400"></span> Zajęcia Online & Na żywo</span>
          <span class="text-violet-400 font-bold">Matura CKE</span>
        </div>
      </div>

      <!-- Prawa strona Bento -->
      <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Bento Karta 2: Statystyka 5+ lat -->
        <div class="bento-card bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-violet-500/40 transition-all rounded-3xl p-6 flex flex-col justify-between">
          <div class="relative z-10 w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center font-bold text-lg mb-4">
            ⏳
          </div>
          <div class="relative z-10">
            <div class="text-4xl font-extrabold text-white tracking-tight">5+ lat</div>
            <div class="text-xs text-zinc-400 mt-1">doświadczenia w przygotowaniu uczniów do matury</div>
          </div>
        </div>

        <!-- Bento Karta 3: Statystyka >90% zdawalności -->
        <div class="bento-card bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-indigo-500/40 transition-all rounded-3xl p-6 flex flex-col justify-between">
          <div class="relative z-10 w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-lg mb-4">
            🎯
          </div>
          <div class="relative z-10">
            <div class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-indigo-300 tracking-tight">>90%</div>
            <div class="text-xs text-zinc-400 mt-1">zdawalność i wysokie wyniki uczniów na egzaminie</div>
          </div>
        </div>

        <!-- Bento Karta 4: Proporcje przedmiotów -->
        <div class="bento-card sm:col-span-2 bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-violet-500/40 transition-all rounded-3xl p-6">
          <div class="relative z-10">
            <span class="text-xs font-bold uppercase tracking-wider text-violet-400 block mb-3">Zakres specjalizacji</span>
            
            <div class="grid grid-cols-2 gap-3">
              <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <div class="text-white font-extrabold text-base flex items-center gap-1.5">
                  <span class="text-violet-400">∑</span> Matematyka
                </div>
                <div class="text-xs text-zinc-400 mt-0.5">Główny profil (80% zajęć)</div>
              </div>

              <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
                <div class="text-white font-extrabold text-base flex items-center gap-1.5">
                  <span class="text-indigo-400">⚡</span> Fizyka
                </div>
                <div class="text-xs text-zinc-400 mt-0.5">Wsparcie (20% zajęć)</div>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-zinc-300">
              <span class="px-2.5 py-1 rounded-lg bg-white/[0.02] border border-white/[0.06]">✓ Funkcje & Ciągi</span>
              <span class="px-2.5 py-1 rounded-lg bg-white/[0.02] border border-white/[0.06]">✓ Kinematyka & Dynamika</span>
              <span class="px-2.5 py-1 rounded-lg bg-white/[0.02] border border-white/[0.06]">✓ Arkusze CKE</span>
            </div>
          </div>
        </div>

        <!-- Bento Karta 5: YouTube -->
        <div class="bento-card sm:col-span-2 bg-gradient-to-r from-violet-950/30 to-indigo-950/30 backdrop-blur-xl border border-violet-500/20 hover:border-violet-500/40 transition-all rounded-3xl p-6 flex items-center justify-between gap-4">
          <div class="relative z-10 space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-red-400 block flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-red-500"></span> Darmowa wiedza
            </span>
            <h3 class="text-lg font-bold text-white">Kanał YouTube: Lekcje u Kuby</h3>
            <p class="text-xs text-zinc-400">Rozwiązania zadań, pułapki maturalne i analiza arkuszy CKE dostępne za darmo.</p>
          </div>
          <a 
            href="https://www.youtube.com/@lekcjeukuby" 
            target="_blank" 
            rel="noopener noreferrer"
            class="relative z-10 px-4 py-2.5 rounded-xl bg-white text-zinc-950 font-bold text-xs hover:bg-zinc-200 transition-colors shrink-0 shadow-sm"
          >
            Oglądaj →
          </a>
        </div>

      </div>

    </div>
  </div>
</section>