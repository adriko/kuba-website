---
---
<section class="pt-12 pb-20 md:pt-20 md:pb-28 border-b border-white/[0.06]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Główny układ Hero: Tekst po lewej, wizytówka/zdjęcie po prawej -->
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Lewa kolumna: Tekst, CTA i wkomponowane Social Media -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse"></span>
          <span>Przygotowanie do matury CKE • Zapisy bezpośrednie</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1]">
          Zrozum matematykę <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-violet-400 to-indigo-300 bg-clip-text text-transparent">
            i fizykę bez stresu.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-400 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Cześć, jestem Jakub. Pomagam zrozumieć matematykę i fizykę bez zbędnego stresu. Rozkładam trudne wzory na proste, logiczne kroki — bez bezmyślnego wkuwania.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-2">
          <a 
            href="#kontakt" 
            class="w-full sm:w-auto px-7 py-3.5 bg-violet-600 hover:bg-violet-500 text-white font-bold text-sm rounded-xl transition-all shadow-lg shadow-violet-600/25"
          >
            Sprawdź wolne terminy
          </a>
          <a 
            href="https://www.youtube.com/@lekcjeukuby" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3.5 bg-white/[0.03] hover:bg-white/[0.06] text-zinc-300 hover:text-white font-semibold text-sm border border-white/[0.08] rounded-xl transition-all flex items-center justify-center gap-2"
          >
            <span>Materiały na YouTube</span>
            <span class="text-xs">→</span>
          </a>
        </div>

        <!-- Dopieszczone ikony społecznościowe -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 text-xs text-zinc-400">
          <span class="font-semibold text-zinc-400/80">Znajdziesz mnie też na:</span>
          <div class="flex items-center gap-2.5">
            <!-- YouTube -->
            <a 
              href="https://www.youtube.com/@lekcjeukuby" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2.5 rounded-xl bg-white/[0.04] hover:bg-red-500/10 text-zinc-300 hover:text-red-400 border border-white/[0.08] hover:border-red-500/40 transition-all duration-200 hover:-translate-y-0.5 shadow-sm" 
              title="YouTube"
            >
              <svg width="18" height="18" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>

            <!-- Discord -->
            <a 
              href="#materialy" 
              class="p-2.5 rounded-xl bg-white/[0.04] hover:bg-indigo-500/10 text-zinc-300 hover:text-indigo-400 border border-white/[0.08] hover:border-indigo-500/40 transition-all duration-200 hover:-translate-y-0.5 shadow-sm" 
              title="Discord"
            >
              <svg width="18" height="18" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </a>

            <!-- Instagram -->
            <a 
              href="#materialy" 
              class="p-2.5 rounded-xl bg-white/[0.04] hover:bg-pink-500/10 text-zinc-300 hover:text-pink-400 border border-white/[0.08] hover:border-pink-500/40 transition-all duration-200 hover:-translate-y-0.5 shadow-sm" 
              title="Instagram"
            >
              <svg width="18" height="18" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>

            <!-- TikTok -->
            <a 
              href="#materialy" 
              class="p-2.5 rounded-xl bg-white/[0.04] hover:bg-cyan-400/10 text-zinc-300 hover:text-cyan-300 border border-white/[0.08] hover:border-cyan-400/40 transition-all duration-200 hover:-translate-y-0.5 shadow-sm" 
              title="TikTok"
            >
              <svg width="18" height="18" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31 0 2.591.24 3.78.685v4.205c-.88-.387-1.844-.61-2.86-.62-.05 0-.098.004-.148.005v7.834c0 3.385-2.75 6.13-6.14 6.13a6.136 6.136 0 0 1-6.135-6.13c0-3.385 2.75-6.135 6.135-6.135.32 0 .633.025.94.075V10.3c-.3-.06-.61-.09-.94-.09-1.07 0-1.93.86-1.93 1.92 0 1.07.86 1.93 1.93 1.93 1.06 0 1.92-.86 1.92-1.93V.02h3.438z"/></svg>
            </a>
          </div>
        </div>

        <!-- Szybkie statystyki w jednym rzędzie -->
        <div class="pt-6 grid grid-cols-2 gap-6 border-t border-white/[0.06] max-w-md mx-auto lg:mx-0">
          <div>
            <div class="text-2xl font-extrabold text-white">5+ lat</div>
            <div class="text-xs text-zinc-400 mt-0.5">doświadczenia w nauczaniu</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-indigo-300">>90%</div>
            <div class="text-xs text-zinc-400 mt-0.5">zdawalność maturzystów</div>
          </div>
        </div>

      </div>

      <!-- Prawa kolumna: Elegancka, czysta karta ze zdjęciem -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl overflow-hidden bg-zinc-900 border border-white/[0.08] aspect-4/5 shadow-2xl group">
          <img 
            src="/kuba.png" 
            alt="Jakub Korzeń - Lekcje u Kuby" 
            class="w-full h-full object-cover object-top group-hover:scale-102 transition duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#08070b] via-transparent to-transparent"></div>
          
          <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between">
            <div>
              <span class="text-xs font-medium text-violet-300 block">Nauczyciel & Twórca</span>
              <span class="text-lg font-bold text-white">Jakub Korzeń</span>
            </div>
            <span class="px-3 py-1 rounded-full bg-white/[0.1] backdrop-blur-md text-[11px] font-medium text-white border border-white/10">
              Online & Stacjonarnie
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>