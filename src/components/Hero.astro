---
---
<section class="relative overflow-hidden bg-slate-50 text-slate-900 pt-10 pb-16 md:pt-16 md:pb-24 border-b border-slate-200/80">
  
  <!-- Subtelna siatka punktowa (zeszyt w kropki) -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:20px_20px] opacity-70 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Lewa kolumna: Treść -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-700 text-xs font-medium shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Przygotowanie do matury CKE • Zapisy bezpośrednie</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-950 leading-[1.15]">
          Zrozum matematykę i fizykę. <br />
          <span class="text-indigo-600">Bez stresu, na Lekcjach u Kuby.</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Cześć, jestem Jakub. Pomagam opanować materiał bez wkuwania schematów na pamięć. Uczę logicznego myślenia i rozbijam skomplikowane zadania na proste etapy.
        </p>

        <!-- Formy zajęć -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 pt-1 text-xs font-semibold">
          <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 shadow-xs flex items-center gap-1.5">
            <span class="text-indigo-600 font-bold">●</span> Online (cała Polska)
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 shadow-xs flex items-center gap-1.5">
            <span class="text-indigo-600 font-bold">●</span> Stacjonarnie
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 shadow-xs flex items-center gap-1.5">
            <span class="text-indigo-600 font-bold">●</span> Notatki PDF po lekcji
          </span>
        </div>

        <!-- Przyciski akcji -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
          <a 
            href="#kontakt" 
            class="w-full sm:w-auto px-7 py-3.5 bg-slate-900 hover:bg-indigo-600 text-white font-bold text-sm rounded-xl transition-all text-center shadow-md shadow-slate-900/10"
          >
            Sprawdź wolne terminy
          </a>
          <a 
            href="https://www.youtube.com/@lekcjeukuby" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-3.5 bg-white hover:bg-slate-50 text-slate-800 font-bold text-sm border border-slate-200 rounded-xl transition-all text-center flex items-center justify-center gap-2 shadow-xs"
          >
            <svg width="16" height="16" class="w-4 h-4 text-red-600 fill-current block" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            Materiały na YouTube
          </a>
        </div>

        <!-- Liczby -->
        <div class="pt-6 border-t border-slate-200 grid grid-cols-2 gap-6 max-w-sm mx-auto lg:mx-0">
          <div>
            <div class="text-3xl font-extrabold text-slate-950">5+ lat</div>
            <div class="text-xs text-slate-500 font-medium mt-0.5">doświadczenia w nauczaniu</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-indigo-600">>90%</div>
            <div class="text-xs text-slate-500 font-medium mt-0.5">zdawalność maturzystów</div>
          </div>
        </div>

      </div>

      <!-- Prawa kolumna: Karta Jakuba -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full max-w-sm bg-white border border-slate-200 rounded-3xl p-4 shadow-xl shadow-slate-200/50">
          
          <div class="relative rounded-2xl overflow-hidden aspect-4/5 bg-slate-100 border border-slate-100">
            <img 
              src="/kuba.png" 
              alt="Jakub Korzeń - Korepetytor" 
              class="w-full h-full object-cover object-top"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-200 block">Nauczyciel & Twórca</span>
              <span class="text-2xl font-extrabold">Jakub Korzeń</span>
            </div>
          </div>

          <div class="mt-3.5 space-y-2">
            <div class="grid grid-cols-2 gap-2 text-center">
              <div class="py-2.5 px-3 rounded-xl bg-slate-50 border border-slate-200/80">
                <div class="text-slate-900 font-extrabold text-sm">∑ Matematyka</div>
                <div class="text-[11px] text-slate-500 font-medium">80% zajęć</div>
              </div>

              <div class="py-2.5 px-3 rounded-xl bg-slate-50 border border-slate-200/80">
                <div class="text-slate-900 font-extrabold text-sm">⚡ Fizyka</div>
                <div class="text-[11px] text-slate-500 font-medium">20% zajęć</div>
              </div>
            </div>

            <div class="py-2.5 px-4 rounded-xl bg-indigo-50 border border-indigo-100 text-center text-xs text-indigo-900 font-semibold">
              🎯 Matura CKE • Egzamin Ósmoklasisty
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>