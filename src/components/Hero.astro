---
---

<section
  id="o-zajeciach"
  class="relative pt-4 pb-12 sm:pt-8 md:pt-14 md:pb-20 border-b border-white/[0.08] overflow-hidden"
>
  <!-- Tło siatki geometrycznej i subtelna poświata -->
  <div class="absolute inset-0 bg-math-grid [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none opacity-60"></div>
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-12 gap-6 md:gap-8 lg:gap-12 items-center">
      
      <!-- Lewa kolumna:
           Mobile (< md): Elegancka, pozioma mini-wizytówka
           Desktop (>= md): Pełne, duże zdjęcie z podpisem -->
      <div class="md:col-span-5">
        
        <!-- WIDOK MOBILNY (< md): Pozioma belka autora -->
        <div class="flex md:hidden items-center gap-3.5 pb-1">
          <div class="w-14 h-14 aspect-square rounded-xl overflow-hidden border border-white/15 bg-zinc-900 shadow-md shrink-0">
            <img
              src="/kuba.png"
              alt="Jakub Korzeń"
              width="56"
              height="56"
              loading="eager"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400 block">Korepetycje z pasją</span>
            <span class="text-sm font-bold text-white block">Jakub Korzeń</span>
            <div class="flex items-center gap-1.5 text-xs text-sky-400 mt-0.5 font-medium">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5"></path>
              </svg>
              <span>Inżynier Politechniki Rzeszowskiej</span>
            </div>
          </div>
        </div>

        <!-- WIDOK DESKTOP (>= md): Duże zdjęcie w lewej kolumnie -->
        <div class="hidden md:flex flex-col items-start">
          <div class="w-full max-w-[260px] aspect-square rounded-2xl overflow-hidden border border-white/10 bg-zinc-900 shadow-xl">
            <img
              src="/kuba.png"
              alt="Jakub Korzeń – Nauczyciel i Korepetytor Matematyki oraz Fizyki"
              width="260"
              height="260"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="mt-3 text-left text-xs text-zinc-300 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5"></path>
            </svg>
            <span class="font-medium text-zinc-300">Inżynier Politechniki Rzeszowskiej</span>
          </div>
        </div>

      </div>

      <!-- Prawa kolumna: Na telefonie wyrównana czytelnie do lewej (text-left) -->
      <div class="md:col-span-7 space-y-4 sm:space-y-5 text-left">
        <div class="space-y-2.5 sm:space-y-3">
          
          <!-- Główny nagłówek -->
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.18]">
            Pewność przy tablicy. <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-sky-300">
              Spokój i wysoki wynik na egzaminie.
            </span>
          </h1>

          <!-- Treść: wyrównana do lewej, czyta się płynnie i komfortowo -->
          <p class="text-sm sm:text-base text-zinc-300 leading-relaxed max-w-xl">
            Cześć, jestem Kuba! Od ponad 5 lat pomagam uczniom zamienić chaos w zeszycie na logiczne myślenie i stabilne oceny. Jako inżynier pokazuję, jak działają wzory w praktyce, zamiast uczyć ich mechanicznie na pamięć. Razem przygotujemy solidną bazę pod maturę CKE lub egzamin ósmoklasisty.
          </p>
        </div>

        <!-- Pasek 3 statystyk -->
        <div class="flex items-center justify-between sm:justify-start gap-3 sm:gap-10 py-3 border-y border-white/[0.08]">
          <div>
            <div class="text-xl sm:text-3xl font-black text-white tracking-tight">5+ lat</div>
            <div class="text-xs text-zinc-400 font-medium">doświadczenia</div>
          </div>
          <div class="w-px h-8 bg-white/10"></div>
          <div>
            <div class="text-xl sm:text-3xl font-black text-sky-400 tracking-tight">&gt;90%</div>
            <div class="text-xs text-zinc-400 font-medium">zdawalności matur</div>
          </div>
          <div class="w-px h-8 bg-white/10"></div>
          <div>
            <div class="text-xl sm:text-3xl font-black text-zinc-200 tracking-tight">PDF</div>
            <div class="text-xs text-zinc-400 font-medium">notatki po lekcji</div>
          </div>
        </div>

        <!-- Przyciski akcji -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-start gap-2.5 pt-1">
          <a
            href="#kontakt"
            class="px-5 py-3 sm:py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-bold text-sm text-center transition-all shadow-md active:scale-95"
          >
            Sprawdź wolne terminy →
          </a>
          <a
            href="https://www.youtube.com/@lekcjeukuby"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 sm:py-2.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-zinc-200 hover:text-white font-medium text-sm transition-all flex items-center justify-center gap-2 active:scale-95"
          >
            <svg class="w-4 h-4 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>Darmowe lekcje na YouTube ↗</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>