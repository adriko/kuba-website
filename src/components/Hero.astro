---
---

<section
  id="o-zajeciach"
  class="relative pt-8 pb-16 md:pt-14 md:pb-20 border-b border-white/[0.08] overflow-hidden"
>
  <!-- Delikatne tło ze wzorem siatki matematycznej i poświatą -->
  <div class="absolute inset-0 bg-math-grid [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none opacity-60"></div>
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Lewa kolumna: Zintegrowana, elegancka karta wizytówki -->
      <div class="md:col-span-5 flex justify-center md:justify-start">
        <div class="w-full max-w-[280px] rounded-2xl bg-zinc-900/80 border border-white/[0.1] p-3.5 shadow-2xl backdrop-blur-md space-y-3.5">
          
          <div class="aspect-square rounded-xl overflow-hidden border border-white/10 bg-zinc-950">
            <img
              src="/kuba.png"
              alt="Jakub Korzeń – Nauczyciel i Korepetytor Matematyki oraz Fizyki"
              width="280"
              height="280"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-full object-cover object-top"
            />
          </div>

          <!-- Metadane i status wewnątrz karty -->
          <div class="space-y-2.5 text-xs">
            <div class="flex items-center gap-2 text-zinc-300 font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
              <span>Online (cała Polska) & Munina</span>
            </div>

            <div class="text-zinc-400 flex items-center gap-2">
              <svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5"></path>
              </svg>
              <span class="truncate">Inżynier Politechniki Rzeszowskiej</span>
            </div>

            <div class="pt-2 border-t border-white/[0.08]">
              <a
                href="https://maps.app.goo.gl/bdKPyWNdRER2nRZ26"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between text-zinc-300 hover:text-white transition-colors"
              >
                <span class="text-amber-400 font-bold flex items-center gap-1">
                  <span>★</span> 5.0 / 5.0
                </span>
                <span class="text-xs text-zinc-400 underline decoration-zinc-600 hover:decoration-white">28 opinii Google →</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Prawa kolumna -->
      <div class="md:col-span-7 space-y-6 text-center md:text-left">
        <div class="space-y-3.5">
          
          <!-- Pulsujący wskaźnik dostępności + Badge -->
          <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-white/10 text-xs font-semibold">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-emerald-400">Trwają zapisy na zajęcia</span>
            <span class="text-zinc-600 hidden sm:inline">•</span>
            <span class="text-zinc-400 font-normal hidden sm:inline">Pojedyncze wolne godziny popołudniowe</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
            Pewność przy tablicy. <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-200 to-sky-300">
              Spokój i wysoki wynik na egzaminie.
            </span>
          </h1>

          <p class="text-sm sm:text-base text-zinc-300 leading-relaxed max-w-xl mx-auto md:mx-0">
            Cześć, jestem Kuba! Od ponad 5 lat pomagam uczniom zamienić chaos w zeszycie na logiczne myślenie i stabilne oceny. Jako inżynier pokazuję, jak działają wzory w praktyce, zamiast uczyć ich mechanicznie na pamięć. Razem przygotujemy solidną bazę pod maturę CKE lub egzamin ósmoklasisty.
          </p>
        </div>

        <!-- Pasek kluczowych osiągnięć / statystyk -->
        <div class="flex items-center justify-center md:justify-start gap-6 sm:gap-10 py-3.5 border-y border-white/[0.08]">
          <div>
            <div class="text-2xl sm:text-3xl font-black text-white tracking-tight">5+ lat</div>
            <div class="text-xs text-zinc-400 font-medium">doświadczenia</div>
          </div>
          <div class="w-px h-8 bg-white/10"></div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-sky-400 tracking-tight">&gt;90%</div>
            <div class="text-xs text-zinc-400 font-medium">zdawalności matur</div>
          </div>
          <div class="w-px h-8 bg-white/10"></div>
          <div>
            <div class="text-2xl sm:text-3xl font-black text-zinc-200 tracking-tight">PDF</div>
            <div class="text-xs text-zinc-400 font-medium">notatki po lekcji</div>
          </div>
        </div>

        <!-- Przyciski akcji (CTA) -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-1">
          <a
            href="#kontakt"
            class="px-5 py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-bold text-xs sm:text-sm transition-all shadow-md shadow-white/5 active:scale-95"
          >
            Sprawdź wolne terminy →
          </a>
          <a
            href="https://www.youtube.com/@lekcjeukuby"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-zinc-200 hover:text-white font-medium text-xs sm:text-sm transition-all flex items-center gap-2 active:scale-95"
          >
            <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>Darmowe lekcje na YouTube</span>
            <span>↗</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>