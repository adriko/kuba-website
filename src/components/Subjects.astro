---
const levels = [
  { name: "Egzamin 8-klasisty", desc: "Powtórka działów, arkusze CKE i pewne punkty na starcie do liceum." },
  { name: "Liceum & Technikum", desc: "Bieżące sprawdziany, kartkówki, nadrabianie zaległości i wyprowadzanie ocen." },
  { name: "Matura Podstawowa", desc: "Opanowanie pewniaków maturalnych, praca z kartą wzorów i spokojne zdanie egzaminu." },
  { name: "Matura Rozszerzona", desc: "Zadania dowodowe, optymalizacja, parametry i walka o wynik na studia techniczne." }
];
---
<section id="oferta" class="py-20 border-b border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-xs font-bold text-violet-400 tracking-wider uppercase mb-2">Oferta zajęć</h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-white">Co razem przerabiamy?</p>
      <p class="text-zinc-400 text-sm mt-2">Dopasowuję tempo pracy do Twoich celów – od nadrabiania zaległości po celowanie w wynik powyżej 85% z matury.</p>
    </div>

    <!-- Poziomy edukacji -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-10">
      {levels.map((lvl, idx) => (
        <div class="bento-card p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] hover:border-violet-500/30 transition-all">
          <div class="relative z-10">
            <span class="text-[10px] font-mono uppercase tracking-wider text-violet-400 block mb-1">Poziom 0{idx + 1}</span>
            <h3 class="font-bold text-white text-sm mb-1.5">{lvl.name}</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">{lvl.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Główne karty przedmiotów -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Matematyka -->
      <div class="bento-card p-8 rounded-3xl bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-violet-500/40 transition-all">
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-violet-500/10 border border-violet-500/20 text-violet-400 flex items-center justify-center font-bold text-xl shadow-sm">
              ∑
            </div>
            <span class="px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold">80% zajęć</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Matematyka (Główny profil)</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6">
            Kompleksowe przygotowanie do matury podstawowej i rozszerzonej, egzaminu ósmoklasisty oraz bieżące nadrabianie zaległości szkolnych.
          </p>
          <ul class="space-y-2.5 text-sm font-medium text-zinc-300">
            <li class="flex items-center gap-2"><span class="text-violet-400">✓</span> Rozwiązywanie arkuszy maturalnych CKE krok po kroku</li>
            <li class="flex items-center gap-2"><span class="text-violet-400">✓</span> Funkcje, geometria, ciągi, prawdopodobieństwo, rachunek różniczkowy</li>
            <li class="flex items-center gap-2"><span class="text-violet-400">✓</span> Rozpracowywanie schematów i typowych pułapek egzaminatorów</li>
          </ul>
        </div>
      </div>

      <!-- Fizyka -->
      <div class="bento-card p-8 rounded-3xl bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-indigo-500/40 transition-all">
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-xl shadow-sm">
              ⚡
            </div>
            <span class="px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold">20% zajęć</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Fizyka</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6">
            Zrozumienie zjawisk fizycznych i przekładanie teorii na praktykę zadaniową. Pomoc w opanowaniu najtrudniejszych działów bez paniki.
          </p>
          <ul class="space-y-2.5 text-sm font-medium text-zinc-300">
            <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Kinematyka, dynamika, praca, moc i zasady zachowania energii</li>
            <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Elektrostatyka, prąd stały, magnetyzm, drgania i optyka</li>
            <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Nauka swobodnego przekształcania wzorów i rachunku jednostek</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Moduł pod Materiały Dodatkowe / Pakiety PDF (BLIK / Naffy) -->
    <div id="arkusze" class="bento-card mt-8 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-violet-950/30 via-indigo-950/20 to-zinc-900/40 border border-violet-500/25 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="relative z-10 space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-violet-500/15 text-violet-300 text-[11px] font-bold uppercase tracking-wider">
          <span>📄</span> Materiały własne & Opracowania PDF
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white">Autorskie pakiety zadań i pewniaki maturalne</h3>
        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
          Przygotowuję uporządkowane zestawy rozwiązanych zadań krok po kroku oraz ściągi ze wzorami, które odblokujesz błyskawicznie (np. przez BLIK) lub otrzymasz bezpłatnie jako mój stały uczeń.
        </p>
      </div>
      <div class="relative z-10 flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto shrink-0">
        <a 
          href="#kontakt" 
          class="px-5 py-3 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-bold text-xs text-center transition-colors shadow-lg shadow-violet-600/20"
        >
          Zapytaj o materiały PDF
        </a>
        <a 
          href="https://www.youtube.com/@lekcjeukuby" 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-zinc-300 font-semibold text-xs text-center transition-colors"
        >
          Darmowe wideo na YT →
        </a>
      </div>
    </div>

  </div>
</section>