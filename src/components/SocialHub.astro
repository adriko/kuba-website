---
---
<section id="materialy" class="py-20 bg-slate-50 border-t border-slate-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-xs font-bold text-indigo-600 tracking-wider uppercase mb-2">Bądźmy w kontakcie</h2>
      <p class="text-3xl font-extrabold text-slate-900">Ucz się ze mną w sieci</p>
      <p class="text-slate-500 mt-2 text-sm">Oglądaj darmowe materiały, sprawdzaj rozwiązania zadań i dołącz do społeczności uczniów.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- YouTube -->
      <a 
        href="https://www.youtube.com/@lekcjeukuby" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-6 bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 group-hover:bg-red-50 group-hover:text-red-600 flex items-center justify-center font-bold mb-4 transition-colors">
            <svg width="20" height="20" class="w-5 h-5 fill-current block" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg group-hover:text-indigo-600 transition-colors">YouTube</h3>
          <p class="text-xs text-slate-500 mt-0.5">@lekcjeukuby</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Dłuższe lekcje, tłumaczenie teorii i arkuszy maturalnych krok po kroku.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-slate-900 group-hover:text-indigo-600 flex items-center gap-1">Subskrybuj kanał →</span>
      </a>

      <!-- Discord -->
      <div class="group p-6 bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 group-hover:bg-indigo-50 group-hover:text-indigo-600 flex items-center justify-center font-bold mb-4 transition-colors">
            <svg width="20" height="20" class="w-5 h-5 fill-current block" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg group-hover:text-indigo-600 transition-colors">Discord</h3>
          <p class="text-xs text-slate-500 mt-0.5">Serwer dla uczniów</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Przestrzeń do zadawania pytań, wzajemnej pomocy i wspólnego rozwiązywania zadań.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-indigo-600 flex items-center gap-1 cursor-pointer">Dołącz do serwera →</span>
      </div>

      <!-- TikTok -->
      <div class="group p-6 bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 group-hover:bg-slate-200 flex items-center justify-center font-bold mb-4 transition-colors">
            <svg width="20" height="20" class="w-5 h-5 fill-current block" viewBox="0 0 24 24"><path d="M12.525.02c1.31 0 2.591.24 3.78.685v4.205c-.88-.387-1.844-.61-2.86-.62-.05 0-.098.004-.148.005v7.834c0 3.385-2.75 6.13-6.14 6.13a6.136 6.136 0 0 1-6.135-6.13c0-3.385 2.75-6.135 6.135-6.135.32 0 .633.025.94.075V10.3c-.3-.06-.61-.09-.94-.09-1.07 0-1.93.86-1.93 1.92 0 1.07.86 1.93 1.93 1.93 1.06 0 1.92-.86 1.92-1.93V.02h3.438z"/></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg group-hover:text-indigo-600 transition-colors">TikTok</h3>
          <p class="text-xs text-slate-500 mt-0.5">Krótkie tipy & triki</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Szybkie patenty na typowe zadania i pułapki maturalne w 60 sekund.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-slate-700 flex items-center gap-1 cursor-pointer">Obserwuj profil →</span>
      </div>

      <!-- Instagram -->
      <div class="group p-6 bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 group-hover:bg-pink-50 group-hover:text-pink-600 flex items-center justify-center font-bold mb-4 transition-colors">
            <svg width="20" height="20" class="w-5 h-5 fill-current block" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </div>
          <h3 class="font-bold text-slate-900 text-lg group-hover:text-indigo-600 transition-colors">Instagram</h3>
          <p class="text-xs text-slate-500 mt-0.5">Wzory & Zapowiedzi</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Pigułki wiedzy, wzory dnia oraz zapowiedzi nadchodzących materiałów.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-slate-700 flex items-center gap-1 cursor-pointer">Zobacz profil →</span>
      </div>

    </div>
  </div>
</section>