---
---
<section id="materialy" class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-xs font-bold text-indigo-600 tracking-wider uppercase mb-2">Bądźmy w kontakcie</h2>
      <p class="text-3xl font-extrabold text-slate-900">Ucz się ze mną w sieci</p>
      <p class="text-slate-500 mt-2 text-sm">Oglądaj darmowe materiały, zadawaj pytania i dołącz do społeczności uczniów.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- YouTube (Prawdziwy link) -->
      <a 
        href="https://www.youtube.com/@lekcjeukuby" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-red-200 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center font-bold mb-4">
            YT
          </div>
          <h3 class="font-bold text-slate-900 text-lg group-hover:text-red-600 transition-colors">YouTube</h3>
          <p class="text-xs text-slate-500 mt-1">@lekcjeukuby</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Dłuższe lekcje, tłumaczenie teorii i zadań krok po kroku.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-red-600 flex items-center gap-1">Subskrybuj →</span>
      </a>

      <!-- Discord (Placeholder) -->
      <div class="group p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-indigo-200 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold mb-4">
            DC
          </div>
          <h3 class="font-bold text-slate-900 text-lg">Discord</h3>
          <p class="text-xs text-slate-500 mt-1">Serwer dla uczniów</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Przestrzeń do zadawania pytań, wzajemnej pomocy i dyskusji o zadaniach.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-indigo-600 flex items-center gap-1 cursor-pointer">Dołącz do serwera →</span>
      </div>

      <!-- TikTok (Placeholder) -->
      <div class="group p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-slate-400 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center font-bold mb-4">
            TT
          </div>
          <h3 class="font-bold text-slate-900 text-lg">TikTok</h3>
          <p class="text-xs text-slate-500 mt-1">Krótkie tipy & triki</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Szybkie patenty na typowe zadania i pułapki maturalne w 60 sekund.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-slate-800 flex items-center gap-1 cursor-pointer">Obserwuj profil →</span>
      </div>

      <!-- Instagram (Placeholder) -->
      <div class="group p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-pink-200 transition-all flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center font-bold mb-4">
            IG
          </div>
          <h3 class="font-bold text-slate-900 text-lg">Instagram</h3>
          <p class="text-xs text-slate-500 mt-1">Fiszki & Relacje</p>
          <p class="text-xs text-slate-600 mt-3 leading-relaxed">Wzory dnia, powtórki przed sprawdzianami i zapowiedzi nowych materiałów.</p>
        </div>
        <span class="mt-6 text-xs font-bold text-pink-600 flex items-center gap-1 cursor-pointer">Zobacz profil →</span>
      </div>

    </div>
  </div>
</section>