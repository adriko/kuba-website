---
const reviews = [
  {
    name: "Mikołaj",
    tag: "Matura rozszerzona",
    stars: 5,
    text: "Z 30% na maturze próbnej do ponad 80% na egzaminie majowym. Kuba potrafi wytłumaczyć każdy schemat bez zbędnego stresu i paniki."
  },
  {
    name: "Zuzanna",
    tag: "Fizyka & Matematyka",
    stars: 5,
    text: "Fizyka wreszcie przestała być czarną magią. Zadania ze zbiorów omawiane krok po kroku na tablecie graficznym, a notatki po lekcji to złoto."
  },
  {
    name: "Kacper",
    tag: "Egzamin CKE",
    stars: 5,
    text: "Najlepszy nauczyciel z jakim miałem do czynienia. Konkretnie, bez lania wody, pełne zaangażowanie i świetna atmosfera na każdych zajęciach."
  }
];
---

<section id="opinie" class="py-20 border-b border-white/[0.08]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Nagłówek sekcji z łączną oceną Google -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-300 text-xs font-semibold">
          <span>★</span> 5.0 / 5.0 • Rekomendacje w Google Maps
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Co mówią uczniowie?</h2>
        <p class="text-xs sm:text-sm text-zinc-400 max-w-lg">
          Prawdziwe opinie uczniów i maturzystów, którzy przygotowywali się do egzaminów na Lekcjach u Kuby.
        </p>
      </div>

      <a 
        href="https://maps.app.goo.gl/bdKPyWNdRER2nRZ26" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-bold text-violet-400 hover:text-violet-300 transition-colors shrink-0"
      >
        <span>Zobacz wszystkie opinie w Google Maps</span>
        <span>→</span>
      </a>
    </div>

    <!-- Siatka kart Bento z opiniami -->
    <div class="grid md:grid-cols-3 gap-4">
      {reviews.map((item) => (
        <div class="bento-card relative p-7 rounded-3xl bg-white/[0.03] backdrop-blur-xl border border-white/[0.08] hover:border-violet-500/40 transition-all flex flex-col justify-between overflow-hidden group">
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-4">
              <div class="flex text-amber-400 text-sm tracking-widest">★★★★★</div>
              <span class="text-[10px] font-semibold px-2.5 py-1 rounded-lg bg-white/[0.04] text-zinc-300 border border-white/[0.06]">{item.tag}</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed italic">„{item.text}”</p>
          </div>
          <div class="relative z-10 mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between">
            <span class="font-bold text-white text-xs">{item.name}</span>
            <span class="text-[10px] text-zinc-500 font-mono">Zweryfikowana opinia</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>