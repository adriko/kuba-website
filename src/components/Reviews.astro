---
const reviews = [
  {
    name: "Mikołaj",
    tag: "Matura rozszerzona",
    text: "Z 30% na maturze próbnej do ponad 80% na egzaminie majowym. Kuba potrafi wytłumaczyć każdy schemat bez zbędnego stresu i paniki."
  },
  {
    name: "Zuzanna",
    tag: "Fizyka & Matematyka",
    text: "Fizyka wreszcie przestała być czarną magią. Zadania omawiane krok po kroku na tablecie graficznym, a notatki w PDF po lekcji to złoto."
  },
  {
    name: "Kacper",
    tag: "Egzamin CKE",
    text: "Konkretnie, bez lania wody i świetna atmosfera na każdych zajęciach. Bardzo polecam każdemu, kto gubi się w szkolnych metodach."
  }
];
---
<section id="opinie" class="py-16 border-b border-white/[0.08]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-sky-400">Rekomendacje</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Opinie uczniów</h2>
      </div>

      <a 
        href="https://maps.app.goo.gl/bdKPyWNdRER2nRZ26" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-xs font-semibold text-zinc-300 hover:text-white transition-colors flex items-center gap-1.5"
      >
        <span>Wszystkie opinie w Google Maps (5.0 ★)</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {reviews.map((r) => (
        <div class="p-5 rounded-2xl bg-zinc-900/60 border border-white/[0.08] flex flex-col justify-between hover:border-white/20 transition-all">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-amber-400 text-sm tracking-wider">★★★★★</span>
              <span class="text-xs font-medium px-2 py-0.5 rounded bg-white/[0.04] text-zinc-300 border border-white/[0.06]">{r.tag}</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed italic">
              „{r.text}”
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-white/[0.08] text-xs font-bold text-zinc-200 flex items-center justify-between">
            <span>{r.name}</span>
            <span class="text-[11px] text-emerald-400 font-normal">Zweryfikowana opinia</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>